{
  "name": "esposito-hifi",
  "version": "6.3.1",
  "description": "Esposito HI-FI — Desktop Music Player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.esposito.hifi",
    "productName": "Esposito HI-FI",
	"copyright": "Copyright © 2026 Esposito",
    "icon": "build/icon.ico",
    "files": [
      "**/*",
      "!node_modules/.cache"
    ],
    "win": {
      "icon": "build/icon.ico",
	  "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    }
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  }
}
